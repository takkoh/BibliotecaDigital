<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clipToPadding="false"
    android:padding="16dp"
    tools:context=".Fragmentos.FragmentCuenta">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/Txt_perfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:letterSpacing="0.02"
            android:text="@string/Txt_perfil"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/Tv_perfil"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_below="@id/Txt_perfil"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"
            android:clickable="true"
            android:focusable="true"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_myplaces"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
            app:strokeColor="?attr/colorPrimary"
            app:strokeWidth="2dp" />

        <TextView
            android:id="@+id/txt_informacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/Tv_perfil"
            android:layout_marginTop="24dp"
            android:gravity="start"
            android:letterSpacing="0.01"
            android:text="Información"
            android:textColor="?attr/colorOnSurface"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Tarjeta contenedora de datos personales -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInfoContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/txt_informacion"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Nombres -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/Txt_nombres"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Txt_nombres"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/Tv_nombres"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="@string/Tv_nombres"
                        android:textColor="?attr/colorOnSurface"
                        android:textStyle="bold" />
                </RelativeLayout>

                <!-- Email -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/Txt_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Txt_email"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/Tv_email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="@string/Tv_email"
                        android:textColor="?attr/colorOnSurface" />
                </RelativeLayout>

                <!-- Nacimiento -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/Txt_nacimiento"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Txt_nacimiento"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/Tv_nacimiento"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="@string/Tv_nacimiento"
                        android:textColor="?attr/colorOnSurface" />
                </RelativeLayout>

                <!-- Miembro -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/Txt_miembro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Txt_miembro"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/Tv_miembro"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="@string/Tv_miembro"
                        android:textColor="?attr/colorOnSurface" />
                </RelativeLayout>

                <!-- Teléfono -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:id="@+id/Txt_telefono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Txt_telefono"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/Tv_telefono"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="@string/Tv_telefono"
                        android:textColor="?attr/colorOnSurface" />
                </RelativeLayout>

                <!-- Estado de cuenta -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/Txt_estado_cuenta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Txt_estado_cuenta"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/Tv_estado_cuenta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="@string/Tv_estado_cuenta"
                        android:textColor="?attr/colorPrimary"
                        android:textStyle="bold" />
                </RelativeLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/TxtOpciones"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/cardInfoContainer"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.01"
            android:text="@string/TxtOpciones"
            android:textColor="?attr/colorOnSurface"
            android:textSize="17sp"
            android:textStyle="bold" />

        <!-- Tarjeta de Opciones / Ajustes -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardOptionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/TxtOpciones"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Editar perfil -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/Btn_editar_perfil"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/m_button_height"
                    android:text="@string/Btn_editar_perfil"
                    app:icon="@android:drawable/ic_menu_edit" />

                <!-- Cerrar sesión -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/Btn_cerrar_sesion"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/m_button_height"
                    android:layout_marginTop="8dp"
                    android:text="@string/Btn_cerrar_sesion"
                    android:textColor="?attr/colorError"
                    android:visibility="visible"
                    app:icon="@android:drawable/ic_lock_power_off"
                    app:iconTint="?attr/colorError" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </RelativeLayout>

</ScrollView>