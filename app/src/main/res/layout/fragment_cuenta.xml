<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp"
    tools:context=".Fragmentos.FragmentCuenta">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/Txt_perfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="MI PERFIL"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="8dp"/>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/Tv_perfil"
            android:layout_below="@id/Txt_perfil"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@android:drawable/ic_menu_myplaces"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="16dp"
            android:scaleType="centerCrop"
            android:clickable="true"
            android:focusable="true"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

        <TextView
            android:id="@+id/txt_informacion"
            android:layout_below="@id/Tv_perfil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:text="Información de Lector"
            android:textStyle="bold"
            android:textSize="17sp"
            android:layout_marginTop="24dp"/>

        <TextView
            android:id="@+id/Txt_nombres"
            android:text="Nombre:"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/txt_informacion"
            android:layout_marginTop="16dp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/Tv_nombres"
            android:text="Lector de Manga"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/txt_informacion"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="16dp"/>

        <TextView
            android:id="@+id/Txt_email"
            android:text="Correo Electrónico:"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/Txt_nombres"
            android:layout_marginTop="16dp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/Tv_email"
            android:text="lector@mangalibrary.com"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/Tv_nombres"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/TxtOpciones"
            android:text="Opciones"
            android:layout_below="@+id/Txt_email"
            android:textSize="17sp"
            android:textStyle="bold"
            android:layout_marginTop="32dp"/>

        <!-- Editar perfil -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/Btn_editar_perfil"
            android:layout_width="220dp"
            android:layout_height="50dp"
            android:layout_centerHorizontal="true"
            android:text="Editar Perfil"
            android:layout_below="@id/TxtOpciones"
            android:layout_marginTop="16dp"
            app:icon="@android:drawable/ic_menu_edit" />

        <!-- Cerrar sesión -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/Btn_cerrar_sesion"
            android:layout_width="220dp"
            android:layout_height="50dp"
            android:layout_centerHorizontal="true"
            android:text="Cerrar Sesión"
            android:layout_below="@id/Btn_editar_perfil"
            android:layout_marginTop="12dp"
            app:icon="@android:drawable/ic_lock_power_off" />
    </RelativeLayout>

</ScrollView>
